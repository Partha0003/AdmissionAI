# ============================================================
# AdmissionAI - Prototype Environment Configuration
# Default Institution: XYZ Engineering College
# ============================================================

PROJECT_NAME=AdmissionAI
ENVIRONMENT=PROTOTYPE

# Institution Configuration
INSTITUTION_NAME="XYZ Engineering College"
INSTITUTION_CODE="XYZ"
ACADEMIC_YEAR="2026-27"

# Security & Authentication
SECRET_KEY="admissionai-super-secret-prototype-key-2026-27"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL default, SQLite fallback supported for testing)
DATABASE_URL="sqlite+aiosqlite:///./admissionai.db"
SYNC_DATABASE_URL="sqlite:///./admissionai.db"
# For PostgreSQL (Docker):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/admissionai"
# SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admissionai"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Mock Integration Flags
MOCK_TNEA_ENABLED=true
MOCK_ERP_ENABLED=true
MOCK_PAYMENT_ENABLED=true
MOCK_NOTIFICATION_ENABLED=true
